# Arthur Play — variabili d'ambiente (copiare in .env nella root del progetto)
# I segreti vanno SOLO nelle variabili d'ambiente, mai nel codice.

# URL pubblico dell'app (link di accesso, QR code)
APP_URL=http://localhost:3000
# URL del servizio realtime visto dal browser. In produzione lasciare vuoto:
# il reverse proxy serve /rt sullo stesso dominio.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Origine consentita dal servizio realtime (CORS)
WEB_ORIGIN=http://localhost:3000
REALTIME_PORT=4000

# Segreto condiviso tra Next e realtime per i ticket di Regia/Proiezione (min 32 caratteri)
REALTIME_SECRET=cambia-questo-segreto-di-sviluppo-lungo-32+

# PostgreSQL: solo account facilitatori, attività, immagini, liste di moderazione
DATABASE_URL=postgres://arthur:arthur@127.0.0.1:5432/arthur_play
# Redis: stato volatile delle sessioni (senza persistenza su disco, vedi infra/redis/redis.conf)
REDIS_URL=redis://127.0.0.1:6379/0

# 1 solo dietro reverse proxy fidato: usa X-Forwarded-For per il rate limiting (IP hashato)
TRUST_PROXY=0

# SMTP del provider email UE (es. Brevo: smtp-relay.brevo.com:587).
# Se SMTP_HOST è vuoto, in sviluppo il magic link viene stampato in console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Arthur Play <no-reply@example.it>

LOG_LEVEL=info

# Funzioni AI (Fase 5) — DISATTIVATE di default. Unico flusso verso un fornitore esterno (Anthropic).
# All'AI vanno solo contenuti del facilitatore e testi delle risposte visibili: mai nickname,
# token, codici o identificativi di sessione, mai risposte filtrate o nascoste.
AI_ENABLED=0
ANTHROPIC_API_KEY=
# Modello principale e riserve, provate in ordine se il precedente non risponde o declina.
AI_MODEL=claude-sonnet-5-5
AI_FALLBACK_MODELS=claude-sonnet-5,claude-haiku-4-5
